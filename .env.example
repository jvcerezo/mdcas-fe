# Base URL of the MDCAS API.
# Leave this blank in development — vite.config.ts proxies /api to the backend,
# so the browser talks to a single origin and CORS never applies.
# Set it in production, e.g. https://mdcas-api.onrender.com
VITE_API_URL=

# Where `npm run dev` should proxy /api. Defaults to http://localhost:5000
VITE_API_PROXY=http://localhost:5000
