# Base URL of the MDCAS API, e.g. https://mdcas-api.onrender.com
#
# LEAVE BLANK to run the site standalone, with no backend at all: content is
# bundled and bookings are stored in the browser. That is the default, so a
# fresh clone and a bare deploy both work with no configuration.
#
# Standalone mode cannot share data between devices and has no real
# authentication. Set this before handling real patient records.
VITE_API_URL=

# Forces the data source regardless of VITE_API_URL:
#   local  standalone, browser storage
#   api    always call the backend
# Leave blank to decide automatically from VITE_API_URL.
VITE_DATA_MODE=

# Where `npm run dev` proxies /api when running against a local backend.
# Only used with VITE_DATA_MODE=api. Defaults to http://localhost:5000
VITE_API_PROXY=http://localhost:5000
